# Copy to .env and adjust. Every value has a working default, so an empty file
# is a valid configuration for local development.
#
# Nothing here may be exposed to the browser. In a Next.js application these
# must stay server-side; never prefix any of them with NEXT_PUBLIC_.

# --- Storage -----------------------------------------------------------------

# "local" (default) writes to the filesystem; "bunny" writes to Bunny Edge Storage.
IMAGE_STORAGE_DRIVER=local

# Local driver
IMAGE_LOCAL_STORAGE_ROOT=public/media
IMAGE_LOCAL_STORAGE_BASE_URL=/media

# Bunny driver. The access key is the storage zone password, not an API key.
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_ACCESS_KEY=
# BUNNY_STORAGE_REGION=de
# BUNNY_CDN_BASE_URL=https://cdn.reptiles.ge

# --- Processing --------------------------------------------------------------

# Set to false to store originals without deriving anything.
IMAGE_PROCESSING_ENABLED=true

# Largest derivative width, and the smaller widths emitted alongside it.
IMAGE_MAX_WIDTH=2400
IMAGE_ADDITIONAL_WIDTHS=1200

# Encoder quality. See docs/benchmarks.md before changing these.
IMAGE_AVIF_QUALITY=60
IMAGE_AVIF_EFFORT=4
IMAGE_AVIF_CHROMA_SUBSAMPLING=4:4:4
IMAGE_WEBP_QUALITY=82
IMAGE_WEBP_EFFORT=5

# --- Limits on untrusted input -----------------------------------------------

IMAGE_MAX_INPUT_BYTES=41943040
IMAGE_MAX_INPUT_PIXELS=80000000
IMAGE_MAX_DIMENSION=20000
IMAGE_PROCESSING_TIMEOUT_SECONDS=60

# --- Layout ------------------------------------------------------------------

IMAGE_ORIGINAL_PREFIX=original
IMAGE_OPTIMIZED_PREFIX=optimized

# --- Social previews ----------------------------------------------------------

# Deliberately JPEG, not AVIF or WebP: link unfurlers decode far less than
# browsers do. See docs/og-images.md. These are resolved separately from the
# settings above, so changing them does not invalidate existing derivatives.

OG_IMAGE_WIDTH=1200
OG_IMAGE_HEIGHT=630
OG_IMAGE_QUALITY=82
OG_IMAGE_MIN_QUALITY=62

# WhatsApp stops showing a preview above roughly this size.
OG_IMAGE_MAX_BYTES=300000

OG_IMAGE_CROP=attention
OG_IMAGE_BACKGROUND=#ffffff
OG_IMAGE_PREFIX=og
